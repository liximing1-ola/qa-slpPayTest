/.idea/
/log/
/time.txt
/.idea/workspace.xml
# Session.checkUserToken 写出的登录 token：slp / xsg 各一份，含真实凭据，绝不能进仓库
# （原来只忽略了已下线项目的 starifyUserToken.txt，slp/xsg 的建议漏掉了）
/common/*UserToken.txt
__pycache__/
common/__pycache__/

# 临时文件：提交信息草稿、根目录下划线开头的临时探针与中间输出，都不进仓库
# （探针一律叫 _probe_xxx.py，输出落到 /log/ 或根目录 _xxx.txt，推之前连目录一起清掉）
.commit_msg.txt
/_*.py
/_*.txt
common/env_local.py
